{
  "name": "lol-skin-tracker",
  "version": "2.0.0",
  "description": "A modern Electron application for tracking your League of Legends champion skins",
  "author": "ZeekWall",
  "main": "build/electron/main.js",
  "homepage": "./",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ZeekWall/LeagueSkinTracker.git"
  },
  "keywords": ["league-of-legends", "electron", "react", "gaming", "skin-tracker"],
  "dependencies": {
    "axios": "^1.11.0",
    "electron-store": "^8.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "electron-dev": "concurrently \"npm start\" \"npm run electron\"",
    "build-electron": "npm run build && tsc electron/main.ts --outDir build/electron --target es2020 --module commonjs --moduleResolution node --esModuleInterop",
    "dist": "npm run build-electron && electron-builder",
    "dist:portable": "npm run build-electron && electron-builder --win portable",
    "test:e2e": "npm run build-electron && npx playwright test",
    "test:e2e:ui": "npm run build-electron && npx playwright test --ui",
    "test:e2e:debug": "npm run build-electron && npx playwright test --debug",
    "mcp:start": "node mcp-server.js",
    "mcp:test": "npm run build-electron && node mcp-server.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.lolskintracker.app",
    "productName": "LoL Skin Tracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "!node_modules/fsevents/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "C:\\Users\\zwall\\Desktop\\Programs\\Coding Stuff\\LeagueSkinTracker\\favicon.ico",
      "artifactName": "${productName}-v${version}-${arch}.${ext}"
    },
    "compression": "maximum",
    "removePackageScripts": true
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.17.2",
    "@playwright/test": "^1.54.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^32.2.7",
    "electron-builder": "^25.1.8",
    "playwright": "^1.54.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.4"
  }
}
