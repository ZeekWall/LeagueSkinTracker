{
  "name": "lol-skin-tracker",
  "version": "3.0.0",
  "description": "A modern web application for tracking your League of Legends champion skins",
  "author": "ZeekWall",
  "main": "build/index.html",
  "homepage": "./",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ZeekWall/LeagueSkinTracker.git"
  },
  "keywords": [
    "league-of-legends",
    "web-app",
    "react",
    "gaming",
    "skin-tracker"
  ],
  "dependencies": {
    "axios": "^1.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "terser": "^5.43.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
